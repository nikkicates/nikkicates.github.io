---
import Layout from '../../layouts/Layout.astro';
import { CALENDAR_URL, CONTACT_EMAIL, CONTACT_WEBHOOK_URL } from '../../config/site';
---

<Layout
  title="Contact | Strategic Transformations Readiness Group"
  description="Contact Nikki Cates and Strategic Transformations Readiness Group about readiness training, keynotes, board briefings, and support for mission-driven and faith-based organizations."
  section="st"
  accentColor="teal"
>

  <section class="section-pad">
    <div class="container-narrow">
      <div class="text-center mb-10 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Contact Me</span>
        <h1 class="font-heading text-3xl md:text-5xl text-light mb-4">Send a message.</h1>
        <p class="text-muted text-base leading-relaxed max-w-xl mx-auto">
          Tell me about your organization and what you are working on. I will reply by email.
          Ready to talk now? <a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer" class="text-teal-DEFAULT underline">Book a discovery call.</a>
        </p>
        <p class="text-muted text-base leading-relaxed max-w-xl mx-auto mt-3">
          Prefer email? Write to <a href={`mailto:${CONTACT_EMAIL}`} class="text-teal-DEFAULT underline">{CONTACT_EMAIL}</a>.
        </p>
      </div>

      <form id="contact-form" class="card border-teal-DEFAULT/20 space-y-5" data-endpoint={CONTACT_WEBHOOK_URL} novalidate>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="form-group">
            <label class="form-label" for="contact-name">Name *</label>
            <input class="form-input" id="contact-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email *</label>
            <input class="form-input" id="contact-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="contact-org">Organization</label>
          <input class="form-input" id="contact-org" name="organization" type="text" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label class="form-label" for="contact-message">Message *</label>
          <textarea class="form-textarea" id="contact-message" name="message" rows="6" required></textarea>
        </div>
        <!-- Honeypot: real visitors never see or fill this field. -->
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn-teal w-full justify-center" id="contact-submit">Send Message</button>
        <div id="contact-status" class="hidden" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>

</Layout>

<script define:vars={{ calendarUrl: CALENDAR_URL, contactEmail: CONTACT_EMAIL }}>
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit');

  function showStatus(html, ok) {
    statusEl.innerHTML = html;
    statusEl.className = ok
      ? 'text-center p-5 rounded-md border border-teal-DEFAULT/40 bg-teal-DEFAULT/5'
      : 'text-center p-5 rounded-md border border-red-500/40 bg-red-900/10';
  }

  const fallback = `Please email <a href="mailto:${contactEmail}" class="underline">${contactEmail}</a> or <a href="${calendarUrl}" target="_blank" rel="noopener noreferrer" class="underline">book a discovery call</a> instead.`;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    if (data.get('website')) return;

    // No webhook yet: open the visitor's email app with the message addressed and filled in.
    const endpoint = (form.dataset.endpoint || '').trim();
    if (!endpoint) {
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const organization = String(data.get('organization') || '').trim();
      const message = String(data.get('message') || '').trim();
      const subject = `Website inquiry from ${name}${organization ? `, ${organization}` : ''}`;
      const body = [
        message,
        '',
        `Name: ${name}`,
        `Email: ${email}`,
        ...(organization ? [`Organization: ${organization}`] : []),
      ].join('\n');
      window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      showStatus(`<p class="text-light text-sm">Your email app should open with your message to ${contactEmail}. Press send there to deliver it. If nothing opened, email <a href="mailto:${contactEmail}" class="underline">${contactEmail}</a> directly.</p>`, true);
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: String(data.get('name') || '').trim(),
          email: String(data.get('email') || '').trim(),
          organization: String(data.get('organization') || '').trim(),
          message: String(data.get('message') || '').trim(),
          source: 'Website Contact Form',
          submitted_at: new Date().toISOString(),
          page_url: window.location.href,
        }),
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.querySelectorAll('input, textarea').forEach((el) => { el.value = ''; });
      showStatus('<p class="text-light text-sm">Thank you. Your message was sent, and I will reply by email.</p>', true);
    } catch {
      showStatus(`<p class="text-red-300 text-sm">Your message could not be sent. ${fallback}</p>`, false);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>
