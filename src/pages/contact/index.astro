---
import Layout from '../../layouts/Layout.astro';
import { BOOKING_SERVICES, CONTACT_EMAIL } from '../../config/site';
---

<Layout
  title="Contact | Strategic Transformations Readiness Group"
  description="Book a call with Nikki Cates and Strategic Transformations Readiness Group about readiness training, keynotes, board briefings, and support for mission-driven and faith-based organizations."
  section="st"
  accentColor="teal"
>

  <section class="section-pad">
    <div class="container-mid">
      <div class="text-center mb-10 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Contact Me</span>
        <h1 class="font-heading text-3xl md:text-5xl text-light mb-4">Book a call.</h1>
        <p class="text-muted text-base leading-relaxed max-w-xl mx-auto">
          Choose the conversation that fits, then pick a time that works for you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {BOOKING_SERVICES.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="card teal-hover flex flex-col gap-2 text-center animate-on-scroll"
          >
            <h2 class="font-heading text-xl font-bold text-teal-DEFAULT">{s.name}</h2>
            <p class="text-muted text-sm leading-relaxed flex-1">{s.desc}</p>
            <span class="btn-teal !text-sm !py-2.5 self-center mt-2">
              Book a Call<span class="sr-only">: {s.name} (opens in a new tab)</span>
            </span>
          </a>
        ))}
      </div>

      <p class="text-muted text-base text-center animate-on-scroll">
        Prefer to write? Email <a href={`mailto:${CONTACT_EMAIL}`} class="text-teal-DEFAULT underline">{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>

</Layout>
