---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The UNMASK Recalibration Course | Coming Soon"
  description="An evergreen, self-paced course version of the UNMASK Leadership Architecture. Release is pending the Vera async build. Get notified when enrollment opens."
  section="st"
  accentColor="teal"
>

  <!-- ─── HERO ─────────────────────────────────────── -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 bg-[#0f172a]"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 70% at 65% 45%, rgba(13,158,138,0.08) 0%, transparent 65%), radial-gradient(ellipse 50% 60% at 5% 85%, rgba(6,70,128,0.1) 0%, transparent 55%);"></div>
    <div class="absolute left-0 top-0 bottom-0 w-[3px]" style="background: linear-gradient(to bottom, transparent 5%, #0D9E8A 25%, #0D9E8A 75%, transparent 95%);"></div>

    <div class="container-mid relative z-10 py-20 md:py-24 text-center">
      <span class="st-tag mb-6 inline-flex animate-on-scroll">Coming Soon · Self-Paced</span>

      <h1 class="font-heading font-bold text-light leading-[1.1] mb-5 animate-on-scroll" style="font-size: clamp(2.2rem, 5vw, 3.6rem);">
        The UNMASK<br/><span class="text-teal-DEFAULT">Recalibration Course.</span>
      </h1>

      <p class="font-body text-lg text-muted leading-relaxed mb-10 max-w-2xl mx-auto animate-on-scroll" style="animation-delay:0.1s">
        The individual-level UNMASK Blueprint, built into a guided, self-paced course.
      </p>

      <div class="max-w-xl mx-auto card teal-hover text-left animate-on-scroll" style="animation-delay:0.15s">
        <p class="text-light text-sm leading-relaxed mb-4">
          We are building an evergreen, on-demand course version of the UNMASK Leadership Architecture:
          video teaching, the Leadership Masking Index, and guided recalibration exercises you can move
          through at your own pace, no cohort schedule required.
        </p>
        <p class="text-muted text-sm leading-relaxed mb-0">
          Release is pending completion of Vera, the async course companion this course is being built
          around. We are not opening enrollment until that build is ready.
        </p>
      </div>
    </div>
  </section>


  <!-- ─── PRICING (UNDER DISCUSSION) ─────────────────── -->
  <section class="section-pad bg-[#0c1525]">
    <div class="container-mid">
      <div class="text-center mb-10 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Planned Pricing</span>
        <h2 class="font-heading text-2xl md:text-3xl text-light">Not final. Still under discussion.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <div class="card teal-hover text-center animate-on-scroll">
          <p class="font-body text-xs font-bold uppercase tracking-widest text-teal-DEFAULT mb-2">Core Course</p>
          <p class="font-heading text-3xl text-light font-bold mb-1">$297&ndash;$497</p>
          <p class="text-muted text-xs">Range under discussion, confirmed at launch</p>
        </div>
        <div class="card teal-hover text-center animate-on-scroll" style="animation-delay:0.08s">
          <p class="font-body text-xs font-bold uppercase tracking-widest text-teal-DEFAULT mb-2">Workbook Add-On</p>
          <p class="font-heading text-3xl text-light font-bold mb-1">$27&ndash;$47</p>
          <p class="text-muted text-xs">Optional, confirmed at launch</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── NOTIFY / IN THE MEANTIME ───────────────────── -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(13,158,138,0.07) 0%, transparent 65%);"></div>
    <div class="container-narrow relative z-10 text-center animate-on-scroll">
      <h2 class="font-heading text-3xl md:text-4xl text-light mb-5 leading-tight">
        Want to know when it opens?
      </h2>
      <p class="text-muted text-lg leading-relaxed mb-8 max-w-xl mx-auto">
        Enrollment is not open yet. Email us and we will let you know the moment it is.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a href="mailto:nikki@strategicunmasking.com?subject=Notify%20me%3A%20UNMASK%20Recalibration%20Course" class="btn-teal text-base !py-4 !px-8">
          Get Notified When It Opens
        </a>
      </div>
      <p class="text-muted text-sm">
        Want to start now? The print and eBook edition of Volume 1 is available today in the
        <a href="/books/#vol-1" class="text-teal-DEFAULT hover:underline">UNMASK Blueprint Series →</a>
      </p>
    </div>
  </section>

</Layout>
