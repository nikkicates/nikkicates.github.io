---
// Neutral personal networking hub (QR-code destination). Standalone on purpose: it does not
// use Layout.astro, so no Strategic Transformations header, nav, logo, or footer appear here.

const SITE = 'https://strategictransformations.net';
const canonicalURL = `${SITE}/structural-burnout/nexus/`;

const NAME = 'Nikki Cates Miller';
const EMAIL = 'nikki@strategicunmasking.com';
const PHONE_DISPLAY = '407-693-4449';
const LICENSE_LINE = 'Nikki Cates Miller, Florida real estate licensee, eXp Realty, Referral Division.';

const title = 'Nikki Cates Miller | Connect';
// Title-line phrases. Phrases never split; from 360px up the line wraps only between the two
// pairs (2 + 2), since text-wrap: balance alone would leave the first phrase on its own line.
const rolePairs = [['Leadership Strategist', 'Real Estate Advisor'], ['Author', 'Army Veteran']];
const description = 'Connect with Nikki Cates Miller: leadership strategist, real estate advisor, author, and U.S. Army veteran.';
const photo = '/images/nc-recalibrate.webp';

// MoneyShow Orlando banner: shown through the end of Oct 12, 2026, America/New_York (EDT, UTC-4).
const BANNER_UNTIL = '2026-10-13T00:00:00-04:00';
const bannerExpiredAtBuild = Date.now() >= Date.parse(BANNER_UNTIL);

// Inline stroke icons (24x24 viewBox), drawn in the accent color.
const icons: Record<string, string> = {
  download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22 6 12 13 2 6"/>',
  arrow: '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  external: '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>',
  layers: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
};
const svg = (name: string, size = 20) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;

const contactActions = [
  { label: 'Book a 20-Minute Conversation', href: 'https://calendar.app.google/e8ErMQqHhmnHn1hk6', icon: 'calendar', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nikkicatesmiller', icon: 'linkedin', external: true },
  { label: `Call or Text ${PHONE_DISPLAY}`, href: 'tel:+14076934449', icon: 'phone' },
  { label: EMAIL, href: `mailto:${EMAIL}`, icon: 'mail' },
];

const doors = [
  {
    id: 'door-st',
    kicker: 'Leadership & AI Strategy',
    label: 'Strategic Transformations',
    icon: 'layers',
    line: 'I equip leaders to build institutions where people can thrive, as AI changes how work gets done.',
    main: { label: 'Visit Strategic Transformations', href: `${SITE}/` },
    links: [
      { label: 'Executive Briefing', href: '/structural-burnout/briefing/' },
      { label: 'Fractional Advisory', href: '/structural-burnout/fractional-lane/' },
      { label: 'Speaking & Training', href: '/speaking-training/' },
      { label: 'UNMASK Blueprint Series', href: '/books/' },
      { label: 'AI Readiness Quiz', href: '/strategic-reset/quiz/' },
    ],
  },
  {
    id: 'door-pci',
    kicker: 'Real Estate Advisory',
    label: 'Pure Compass Investments',
    icon: 'compass',
    line: 'Clarity Before Capital. Education, advisory, and referral coordination for first-generation wealth builders, diaspora investors, and inheriting families.',
    main: { label: 'Visit Pure Compass', href: 'https://purecompassinvest.com/', external: true },
    links: [
      { label: 'Book a Strategy Call', href: 'https://api.leadconnectorhq.com/widget/bookings/pure-compass-scheduling', external: true },
      { label: 'About Nikki', href: 'https://purecompassinvest.com/#founder', external: true },
      { label: 'Clarity Before Capital Newsletter', href: 'https://claritybeforecapital.beehiiv.com', external: true },
    ],
    fine: `${LICENSE_LINE.replace(/\.$/, '')}. Education and referral coordination only. Not investment management advice.`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${SITE}${photo}`} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}${photo}`} />
    <meta name="theme-color" content="#F7F3EC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap" />
  </head>

  <body class="hub">
    <main class="wrap">

      <!-- Identity -->
      <header class="identity">
        <img src={photo} alt={NAME} width="132" height="132" class="photo" loading="eager" fetchpriority="high" />
        <h1 class="name">{NAME}</h1>
        <p class="role">
          {rolePairs.map((pair, p) => (
            <Fragment>
              <span class="pair">{pair.map((r, i) => (
                <Fragment><span class="nowrap">{r}{(p === 0 || i === 0) && ' ·'}</span>{i === 0 && ' '}</Fragment>
              ))}</span>{p === 0 && ' '}
            </Fragment>
          ))}
        </p>
        <p class="intro">I help leaders and families build on solid structure, from institutions to first investments.</p>
      </header>

      <!-- Event banner: removed from builds after the cutoff, hidden client-side once the cutoff passes. -->
      {!bannerExpiredAtBuild && (
        <div class="banner" data-show-until={BANNER_UNTIL} hidden>
          <p><strong>Great meeting you at MoneyShow Orlando.</strong> Save my contact or book a time to continue the conversation.</p>
        </div>
      )}
      <script is:inline>
        document.querySelectorAll('[data-show-until]').forEach(function (el) {
          el.hidden = Date.now() >= Date.parse(el.getAttribute('data-show-until'));
        });
      </script>

      <!-- Primary actions. The licensing line is inside this same group, directly under the
           contact buttons, so it stays adjacent at every width (Fla. Admin. Code R. 61J2-10.025). -->
      <section class="actions" id="contact" aria-label="Contact">
        <a href="/nikki-cates.vcf" class="btn btn-primary">
          <Fragment set:html={svg('download')} />
          <span>Save Contact to Phone</span>
        </a>
        {contactActions.map((a) => (
          <a href={a.href} class="btn btn-outline" target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener' : undefined}>
            <Fragment set:html={svg(a.icon)} />
            <span class="btn-text">{a.label}</span>
          </a>
        ))}
        <p class="license" id="license-line">Real estate services: {LICENSE_LINE}</p>
      </section>

      <!-- Two doors. Door A first by default; ?focus=pci moves Door B first. -->
      <div class="doors" id="doors">
        {doors.map((d) => (
          <section class="door" id={d.id} aria-labelledby={`${d.id}-label`}>
            <p class="door-kicker"><Fragment set:html={svg(d.icon, 18)} />{d.kicker}</p>
            <h2 class="door-label" id={`${d.id}-label`}>{d.label}</h2>
            <p class="door-line">{d.line}</p>
            <a href={d.main.href} class="btn btn-primary" target={d.main.external ? '_blank' : undefined} rel={d.main.external ? 'noopener' : undefined}>
              <span>{d.main.label}</span>
              <Fragment set:html={svg('arrow', 18)} />
            </a>
            <div class="door-body">
              <ul class="door-links">
                {d.links.map((l) => (
                  <li>
                    <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                      <span>{l.label}</span>
                      <Fragment set:html={svg(l.external ? 'external' : 'arrow', 16)} />
                    </a>
                  </li>
                ))}
              </ul>
              {d.fine && <p class="door-fine">{d.fine}</p>}
            </div>
          </section>
        ))}
      </div>
      <script is:inline>
        if (new URLSearchParams(location.search).get('focus') === 'pci') {
          var doors = document.getElementById('doors');
          doors.insertBefore(document.getElementById('door-pci'), doors.firstElementChild);
        }
      </script>

      <footer class="foot">© {new Date().getFullYear()} {NAME}</footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #F7F3EC;
    --ink: #1F1A24;
    --accent: #4A2545;
    --ink-soft: rgba(31, 26, 36, 0.74);
    --line: rgba(31, 26, 36, 0.14);
    --card: #FFFFFF;
    --serif: 'Fraunces', 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
    --sans: 'Work Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  html { background: var(--bg); }
  body.hub {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .hub a { color: inherit; text-decoration: none; }
  .hub :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 10px; }

  .wrap { max-width: 480px; margin: 0 auto; padding: 32px 16px 40px; }

  .identity { text-align: center; margin-bottom: 20px; }
  .photo {
    width: 132px; height: 132px; border-radius: 50%; object-fit: cover; object-position: center;
    display: block; margin: 0 auto 16px; border: 3px solid var(--card); box-shadow: 0 0 0 1px var(--line);
  }
  .name { font-family: var(--serif); font-weight: 600; font-size: 2rem; line-height: 1.15; margin: 0 0 8px; letter-spacing: -0.01em; }
  .role { font-size: 0.9rem; font-weight: 500; color: var(--accent); margin: 0 0 12px; text-wrap: balance; }
  .nowrap { white-space: nowrap; }
  @media (min-width: 360px) { .role .pair { white-space: nowrap; } }
  .intro { font-size: 1rem; color: var(--ink-soft); margin: 0 auto; max-width: 34ch; }

  .banner {
    background: var(--card); border: 1px solid var(--accent); border-left-width: 4px;
    border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; font-size: 0.95rem;
  }
  .banner p { margin: 0; }
  .banner strong { color: var(--accent); font-weight: 600; }

  .actions { display: flex; flex-direction: column; gap: 10px; margin-bottom: 32px; }

  .btn {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 52px; padding: 12px 16px; border-radius: 12px;
    font-family: var(--sans); font-size: 1rem; font-weight: 600; text-align: center;
    transition: background-color .15s, border-color .15s, color .15s;
  }
  .btn svg { flex-shrink: 0; }
  .btn-primary { background: var(--accent); color: #fff !important; border: 1px solid var(--accent); }
  .btn-primary:hover { background: #3a1c36; }
  .btn-outline { background: var(--card); color: var(--ink); border: 1px solid var(--line); min-height: 48px; }
  .btn-outline svg { color: var(--accent); }
  .btn-outline:hover { border-color: var(--accent); }
  .btn-text { overflow-wrap: anywhere; }

  .license { margin: 2px 4px 0; font-size: 0.8rem; line-height: 1.45; color: var(--ink-soft); text-align: center; }

  .doors { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .door {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 20px; display: flex; flex-direction: column;
  }
  .door-kicker {
    display: flex; align-items: center; gap: 8px; margin: 0 0 4px;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent);
  }
  .door-label { font-family: var(--serif); font-weight: 600; font-size: 1.4rem; line-height: 1.2; margin: 0 0 8px; }
  .door-line { margin: 0 0 16px; color: var(--ink-soft); font-size: 0.95rem; }
  .door-links { list-style: none; margin: 12px 0 0; padding: 0; }
  .door-links li + li { border-top: 1px solid var(--line); }
  .door-links a {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 48px; padding: 8px 4px; font-weight: 500;
  }
  .door-links a svg { color: var(--accent); flex-shrink: 0; }
  .door-links a:hover span { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .door-fine { margin: 0; padding-top: 14px; font-size: 0.75rem; line-height: 1.45; color: var(--ink-soft); }

  .foot { text-align: center; font-size: 0.8rem; color: var(--ink-soft); margin-top: 32px; }

  @media (min-width: 768px) {
    .wrap { max-width: 880px; padding-top: 56px; }
    .identity, .banner, .actions { max-width: 480px; margin-left: auto; margin-right: auto; }
    .banner { margin-bottom: 16px; }
    .actions { margin-bottom: 40px; }
    .doors { grid-template-columns: 1fr 1fr; gap: 20px; }
    /* Equal-height doors whose kicker, label, line, button, and link list share rows, so the
       link lists start at the same height and leftover space falls at the card bottom. */
    @supports (grid-template-rows: subgrid) {
      .doors { row-gap: 0; }
      .door { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; align-content: start; }
    }
  }
</style>
