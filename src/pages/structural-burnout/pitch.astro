---
import Layout from '../../layouts/Layout.astro';

const revenueRows = [
  { line: 'High-Ticket Consulting Services', status: 'Active', model: 'Proposal-based · UNMASK Diagnostic, Recalibration, AI Audit, Retainer' },
  { line: 'Speaking & Keynotes', status: 'Active', model: 'Proposal-based · 5 signature talks, conference and corporate circuit' },
  { line: 'UNMASK Blueprint Series', status: 'Active', model: 'Individual + institutional licensing · 3 published volumes' },
  { line: 'URI Formation', status: 'Active', model: 'Proposal-based · justice-centered leadership formation, mission-aligned revenue' },
  { line: 'UNMASK Recalibrate App', status: 'In Development', model: 'Freemium · free SSS tier → premium LMI/RAA/ABAI access' },
  { line: 'Enterprise Framework Licensing', status: 'Pipeline', model: 'Scope-based · org-wide deployment, practitioner certification, white-label infrastructure' },
];

const statusClass = (status: string) => {
  if (status === 'Active') return 'text-teal-DEFAULT border-teal-DEFAULT/40 bg-teal-DEFAULT/10';
  if (status === 'In Development') return 'text-gold border-gold/40 bg-gold/10';
  return 'text-muted border-border bg-white/5';
};
---

<Layout
  title="Investor Hub - Strategic Transformations"
  description="Strategic Transformations is scaling its structural burnout methodology into a multi-product, multi-channel enterprise. Review the investment thesis, traction, and opportunity."
  section="st"
  accentColor="teal"
>

  <!-- ─── HERO ─────────────────────────────────────── -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-st-gradient"></div>
    <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-teal-DEFAULT"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 60% at 70% 50%, rgba(13,158,138,0.08) 0%, transparent 65%);"></div>
    <div class="container-mid relative z-10 text-center lg:text-left">
      <span class="st-tag mb-5 inline-flex mx-auto lg:mx-0 animate-on-scroll">Investor Hub · Confidential Overview</span>
      <span class="mb-5 inline-flex mx-auto lg:mx-0 items-center gap-2 text-xs font-bold uppercase tracking-wide text-gold border border-gold/50 bg-gold/10 rounded-full px-4 py-1.5 animate-on-scroll" style="animation-delay:0.05s">
        Pre-Seed · Founder-Built, Infrastructure-Backed
      </span>
      <h1 class="font-heading text-4xl md:text-6xl text-light font-bold mb-5 animate-on-scroll" style="animation-delay:0.1s">
        The $88B Burnout Market Has No Structural Answer.
        <span class="text-gold">We Built the Diagnostic For It.</span>
      </h1>
      <p class="text-muted text-base max-w-2xl mx-auto lg:mx-0 mb-10 animate-on-scroll" style="animation-delay:0.15s">
        Strategic Transformations is a structural burnout consultancy with a proprietary diagnostic framework,
        an operating AI-agent delivery stack, and a founder whose lived authority cannot be manufactured or
        replicated. We are raising early-stage capital to convert a working, revenue-generating methodology
        into licensable, scalable infrastructure.
      </p>
      <div class="flex flex-wrap justify-center lg:justify-start gap-4 animate-on-scroll" style="animation-delay:0.2s">
        <a href="/structural-burnout/briefing" class="btn-teal">Request Investor Briefing →</a>
        <a href="/structural-burnout/services" class="btn-outline-teal">View Service Architecture</a>
      </div>
      <p class="text-xs text-muted mt-6 max-w-2xl mx-auto lg:mx-0 animate-on-scroll italic">
        Market figures are sourced from publicly available industry research. Projections are
        forward-looking strategic modeling, not guarantees. Full investor deck available upon request after briefing.
      </p>
    </div>
  </section>


  <!-- ─── KEY METRICS STRIP ─────────────────────────── -->
  <section class="bg-surface border-y border-border py-8">
    <div class="container-wide">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { num: '$88B+',  label: 'Global Burnout Economic Cost', source: 'Gallup / WHO estimates' },
          { num: '77%',    label: 'Workers Reporting Burnout',    source: 'Gallup State of Global Workplace' },
          { num: '2–3×',  label: 'Salary Cost to Replace Burned-Out Employee', source: 'SHRM / industry research' },
          { num: '$1.1T', label: 'US Productivity Loss from Disengagement', source: 'Gallup 2024 estimate' },
        ].map((m) => (
          <div>
            <p class="font-heading text-3xl text-teal-DEFAULT font-bold">{m.num}</p>
            <p class="text-light text-xs font-semibold mt-2 leading-snug">{m.label}</p>
            <p class="text-muted text-xs mt-1 italic">{m.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── THE MARKET PROBLEM ───────────────────────── -->
  <section class="section-pad bg-[#0c1525]">
    <div class="container-wide">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Market Problem</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">
          A multi-billion dollar problem.<br/>
          <span class="text-teal-DEFAULT">Zero structural solutions.</span>
        </h2>
        <p class="text-muted text-sm mt-4 max-w-xl mx-auto">
          The burnout market has generated massive investment, and virtually none of it
          addresses the actual source of the problem.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
        {[
          {
            label: 'Human Sustainability Vendors',
            size: '$61B+ market',
            problem: 'Treats burnout as an individual issue disconnected from leadership architecture risk. Mindfulness apps, EAPs, resilience trainings. All downstream.',
            failure: 'None of it changes the structure producing the exhaustion.',
          },
          {
            label: 'Traditional HR Consulting',
            size: '$37B+ market',
            problem: 'Engagement surveys, pulse checks, policy recommendations. Measures symptoms without structural diagnosis.',
            failure: 'Output is a report. Not recalibration.',
          },
          {
            label: 'Culture & Sustainability Programs',
            size: '$9.3B market',
            problem: 'Valuable but typically siloed. Addresses inclusion and support without diagnosing leadership architecture risk.',
            failure: 'People feel seen. Still burned out.',
          },
        ].map((item) => (
          <div class="card border-red-500/15 text-center animate-on-scroll">
            <div class="flex items-start justify-between mb-3 gap-3">
              <p class="font-heading text-light font-semibold">{item.label}</p>
              <span class="text-xs text-muted border border-border rounded px-2 py-0.5 shrink-0">{item.size}</span>
            </div>
            <p class="text-muted text-sm mb-4 leading-relaxed">{item.problem}</p>
            <div class="border-t border-red-500/15 pt-3">
              <p class="text-red-400/80 text-xs flex items-start gap-1.5">
                <span class="shrink-0">✗</span>{item.failure}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="max-w-2xl mx-auto text-center animate-on-scroll">
        <div class="card border-teal-DEFAULT/40 bg-teal-glow p-8">
          <p class="font-heading text-teal-DEFAULT text-xl font-semibold mb-3">
            Strategic Transformations fixes the design.
          </p>
          <p class="text-muted text-sm leading-relaxed">
            The only practitioner-developed framework that treats burnout as a structural failure and delivers
            a diagnostic and recalibration pathway that addresses it at the root - not downstream, not symptomatic.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── THE SOLUTION ──────────────────────────────── -->
  <section class="section-pad">
    <div class="container-wide">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">The Solution</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">
          One methodology, tested in community,<br/>monetized at scale.
        </h2>
      </div>

      <div class="max-w-3xl mx-auto mb-16 animate-on-scroll">
        <div class="card border-gold/40 bg-gold-glow p-8">
          <p class="text-muted text-sm leading-relaxed">
            ST is often read as two brands: a corporate structural-diagnostics consultancy, and a faith-grounded
            formation practice for women of color leaders. <strong class="text-light">They are one R&amp;D pipeline.</strong>
            URI Formation and the UNMASK community are where the framework is tested against real, high-stakes
            lived experience - the population most exposed to structural strain and least served by existing
            burnout solutions. The corporate consulting arm, the diagnostic instruments, and the enterprise
            licensing pipeline are where that tested intelligence is converted into a measurable, sellable
            product. The community isn't a separate audience to manage around the corporate voice. It's the
            validation source the corporate voice is built on.
          </p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto mb-16 animate-on-scroll" style="animation-delay:0.05s">
        <h3 class="font-heading text-xl text-teal-DEFAULT font-semibold mb-3 text-center">The UNMASK Framework</h3>
        <p class="text-muted text-sm leading-relaxed mb-6 text-center max-w-2xl mx-auto">
          A diagnostic and recalibration methodology that identifies hidden strains - the "masks" individuals,
          institutions, and communities wear under systemic pressure - and rebuilds authentic leadership capacity.
          Developed through direct organizational consulting and grounded in Womanist theology.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
          {[
            { letter: 'U', name: 'Uncover', desc: 'Surface the hidden strains normalized into invisibility.' },
            { letter: 'N', name: 'Navigate', desc: 'Map the structural conditions driving exhaustion and attrition.' },
            { letter: 'M', name: 'Manage', desc: 'Develop recalibration strategies with clear accountability.' },
            { letter: 'A', name: 'Advocate', desc: 'Champion the systemic changes required for flourishing.' },
            { letter: 'S', name: 'Sustain', desc: 'Embed recalibration into ongoing operational rhythm.' },
            { letter: 'K', name: 'Kindle', desc: 'Ignite collective capacity in leaders and teams.' },
          ].map((p) => (
            <div class="bg-surface border border-border border-t-2 border-t-teal-DEFAULT rounded-md p-4">
              <p class="font-heading text-light text-sm font-semibold mb-1">{p.letter} · {p.name}</p>
              <p class="text-muted text-xs leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="max-w-4xl mx-auto animate-on-scroll" style="animation-delay:0.1s">
        <h3 class="font-heading text-xl text-teal-DEFAULT font-semibold mb-3 text-center">Delivery Infrastructure, Not Just Founder Bandwidth</h3>
        <p class="text-muted text-sm leading-relaxed mb-6 text-center max-w-2xl mx-auto">
          The methodology already runs on systemized tools built to operate independent of any single engagement.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {[
            { title: 'Vera — AI Diagnostic Engine', desc: 'Voiceflow + Airtable-integrated diagnostic tool. Delivers the entry Structural Strain Score without founder involvement in every intake.' },
            { title: 'Four Scoreable Instruments', desc: 'Structural Strain Score, Leadership Masking Index, RAA Index, AI Burnout Accelerator Index. Licensable, standardized, and repeatable across sectors.' },
            { title: 'Agent-Operated Delivery Stack', desc: "Prospecting, nurture, and operations agents already run core GTM and client-ops workflows - proof the practice is being built to operate beyond one person's calendar." },
          ].map((c) => (
            <div class="bg-navy-DEFAULT rounded-lg p-6 border border-navy-light/30">
              <h4 class="font-heading text-gold text-base font-semibold mb-2">{c.title}</h4>
              <p class="text-sm leading-relaxed" style="color:#DCE6F2">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ─── REVENUE ARCHITECTURE ──────────────────────── -->
  <section class="section-pad bg-[#0c1525]">
    <div class="container-wide">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Revenue Architecture</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">Multi-channel, already active.</h2>
      </div>

      <div class="overflow-x-auto animate-on-scroll max-w-4xl mx-auto">
        <table class="w-full border-collapse bg-surface rounded-md overflow-hidden">
          <thead>
            <tr>
              <th class="bg-navy-DEFAULT text-light text-left text-xs uppercase tracking-wide font-semibold px-4 py-3">Line</th>
              <th class="bg-navy-DEFAULT text-light text-left text-xs uppercase tracking-wide font-semibold px-4 py-3">Status</th>
              <th class="bg-navy-DEFAULT text-light text-left text-xs uppercase tracking-wide font-semibold px-4 py-3">Model</th>
            </tr>
          </thead>
          <tbody>
            {revenueRows.map((r) => (
              <tr class="border-b border-border last:border-b-0">
                <td class="px-4 py-3.5 text-light text-sm font-semibold whitespace-nowrap">{r.line}</td>
                <td class="px-4 py-3.5">
                  <span class={`text-xs font-bold px-2.5 py-1 rounded-full border uppercase tracking-wide whitespace-nowrap ${statusClass(r.status)}`}>{r.status}</span>
                </td>
                <td class="px-4 py-3.5 text-muted text-sm">{r.model}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- ─── FOUNDER PROFILE ───────────────────────────── -->
  <section class="section-pad">
    <div class="container-wide">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Founder</span>
        <h2 class="font-heading text-3xl text-light">
          Authority that seeds the IP.<br/>Infrastructure that scales it.
        </h2>
        <p class="text-muted text-sm mt-3 max-w-lg mx-auto">
          ST's founder built the diagnostic system from inside the problem, and has already begun converting
          that authority into transferable assets so the methodology does not require her presence in every
          room to deliver value.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            icon: '🎖️',
            label: 'Army Veteran',
            desc: 'Crisis leadership and organizational systems thinking applied to a civilian burnout epidemic.',
          },
          {
            icon: '✍🏾',
            label: 'Practitioner-Scholar',
            desc: 'Graduate work in Religions, Ethics & Public Intellectuals. Womanist theology as epistemological foundation.',
          },
          {
            icon: '🏗️',
            label: 'Framework Creator',
            desc: 'UNMASK developed through direct consulting, now documented, instrumented, and licensable.',
          },
          {
            icon: '📖',
            label: 'Published Author',
            desc: 'Three-volume UNMASK Blueprint Series builds inbound pipeline independent of speaking calendar.',
          },
          {
            icon: '🌐',
            label: 'Liberation Grounded',
            desc: 'Womanist ethics and liberation philosophy differentiate ST from performance-optimization consultants.',
          },
          {
            icon: '🤝',
            label: 'Cross-Sector Track Record',
            desc: "Nonprofit, faith-based, corporate, government, higher education. The solution isn't industry-specific.",
          },
        ].map((item) => (
          <div class="card teal-hover animate-on-scroll">
            <span class="text-2xl block mb-3">{item.icon}</span>
            <p class="font-heading text-light font-semibold text-sm mb-2">{item.label}</p>
            <p class="text-muted text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ─── SEED CAPITAL USE ──────────────────────────── -->
  <section class="section-pad bg-[#0c1525]">
    <div class="container-wide">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Seed Capital</span>
        <h2 class="font-heading text-3xl text-light">What this capital actually unlocks.</h2>
        <p class="text-muted text-sm mt-3 max-w-xl mx-auto">
          ST is early-stage and founder-funded to date. The methodology is proven, documented, and generating
          revenue. What's missing is not validation, it's access: the operating capital to reach the networks,
          markets, and licensing infrastructure that turn a working practice into a scalable one.
        </p>
      </div>

      <div class="max-w-3xl mx-auto bg-navy-DEFAULT rounded-xl p-8 md:p-10 mb-16 animate-on-scroll">
        <h3 class="font-heading text-light text-xl font-semibold">This raise moves ST from founder-powered to infrastructure-powered.</h3>
        <ul class="mt-5">
          {[
            'Market and network access — conference circuit, enterprise pipeline development, warm-intro capital ST cannot self-fund at current stage',
            'Licensing infrastructure — the legal, IP-protection, and platform buildout required to license the four instruments and UNMASK Recalibrate at scale',
            "Certification pathway — the training and quality-control infrastructure that lets certified practitioners deliver the methodology, reducing dependence on the founder's personal calendar",
            'Product buildout — UNMASK SaaS platform, AI-enhanced diagnostics integrated into the existing agent stack',
          ].map((item) => (
            <li class="flex items-start gap-3 py-3 border-b border-white/10 last:border-b-0 text-sm" style="color:#DCE6F2">
              <span class="text-gold font-bold shrink-0">→</span>{item}
            </li>
          ))}
        </ul>
      </div>

      <!-- The investor standard -->
      <div class="max-w-2xl mx-auto card border-teal-DEFAULT/30 bg-teal-glow p-8 text-center animate-on-scroll">
        <p class="font-heading text-teal-DEFAULT text-lg font-semibold mb-3">
          What we're looking for in a capital partner.
        </p>
        <div class="space-y-2 text-left mb-6">
          {[
            'Alignment with the liberation-grounded vision, not just the financials',
            'Understanding that justice-centered frameworks are the future of organizational health',
            'Patient capital that supports a build designed for scale, not a quick exit',
            'Connections and relationships in the enterprise, nonprofit, and academic markets',
            "Respect for the founder's intellectual authority and methodological sovereignty",
          ].map((item) => (
            <div class="flex items-start gap-2 text-sm text-muted">
              <span class="text-teal-DEFAULT shrink-0">✓</span>{item}
            </div>
          ))}
        </div>
        <p class="text-muted text-xs italic">
          Strategic Transformations is not looking for investors who want to change the vision.
          We are looking for investors who understand what it is, and want to build it with us.
        </p>
      </div>
    </div>
  </section>


  <!-- ─── CTA ───────────────────────────────────────── -->
  <section class="py-16 relative overflow-hidden">
    <div class="container-narrow text-center animate-on-scroll">
      <h2 class="font-heading text-3xl text-light mb-4">
        Ready to explore alignment?
      </h2>
      <p class="text-muted mb-8 max-w-xl mx-auto text-sm">
        All investor conversations begin with an Executive Briefing.
        The full investor deck - including financial projections, revenue model detail,
        and capitalization structure - is available by request only after vetting.
      </p>
      <a href="/structural-burnout/briefing" class="btn-teal text-base !py-4 !px-8">
        Request Investor Briefing →
      </a>
    </div>
  </section>

</Layout>
