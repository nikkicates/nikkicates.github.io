---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} | Insights`}
  description={post.data.description}
  section="st"
  accentColor="teal"
>
  <section class="section-pad">
    <div class="container-narrow">
      <a href="/insights/" class="text-teal-DEFAULT text-sm hover:underline">&larr; All Insights</a>
      <p class="text-muted text-xs uppercase tracking-widest mt-6 mb-2">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        &middot; {post.data.author}
      </p>
      <h1 class="font-heading text-3xl md:text-4xl text-light font-bold mb-8">{post.data.title}</h1>
      <div class="prose-insights">
        <Content />
      </div>
    </div>
  </section>
</Layout>

<style>
  .prose-insights :global(p) { color: #cbd5e1; line-height: 1.8; margin-bottom: 1.25rem; }
  .prose-insights :global(h2) { color: #f8fafc; font-family: 'Lora', serif; font-size: 1.5rem; margin: 2rem 0 1rem; }
  .prose-insights :global(a) { color: #0D9E8A; }
</style>
