---
import Layout from '../layouts/Layout.astro';
import { WEBINAR_URL, CALENDAR_URL, BOOKING_NOTE } from '../config/site';
---

<Layout
  title="Strategic Transformations Readiness Group | Ethical AI Readiness and Governance for Mission-Driven Organizations"
  fullTitle
  description="Strategic Transformations Readiness Group: Ethical AI readiness and governance for mission-driven organizations. Nikki Cates equips mission-driven and faith-based organizations to prepare their people for AI."
  section="st"
  accentColor="teal"
>

  <!-- ─── HERO ─────────────────────────────────────── -->
  <section class="relative min-h-[94vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 bg-[#0f172a]"></div>
    <!-- Gradient atmosphere -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 70% at 65% 45%, rgba(13,158,138,0.08) 0%, transparent 65%), radial-gradient(ellipse 50% 60% at 5% 85%, rgba(6,70,128,0.1) 0%, transparent 55%);"></div>
    <!-- Left vertical accent -->
    <div class="absolute left-0 top-0 bottom-0 w-[3px]" style="background: linear-gradient(to bottom, transparent 5%, #0D9E8A 25%, #0D9E8A 75%, transparent 95%);"></div>

    <div class="container-wide relative z-10 py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

        <!-- Left: Core message -->
        <div class="lg:col-span-7 text-center">
          <div class="st-tag mb-3 mx-auto animate-on-scroll">
            <svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor"><circle cx="3" cy="3" r="3"/></svg>
            Strategic Transformations Readiness Group
          </div>
          <p class="font-heading italic text-light/80 text-base mb-6 mx-auto animate-on-scroll">
            Ethical AI readiness and governance for mission-driven organizations
          </p>

          <h1 class="font-heading font-bold text-light leading-[1.06] mb-6 animate-on-scroll" style="font-size: clamp(2.4rem, 5.5vw, 4.2rem); animation-delay:0.05s">
            Hold the people<br/>
            <span class="text-teal-DEFAULT">who hold your mission.</span>
          </h1>

          <p class="font-body text-teal-DEFAULT text-lg font-semibold italic leading-relaxed mb-6 max-w-2xl mx-auto animate-on-scroll" style="animation-delay:0.1s">
            Strategic Transformations Readiness Group equips international mission-driven and faith-based organizations to redesign the human side of the Human x AI workforce, so they retain their best people, protect the trust they have earned, and reduce risk in the age of AI.
          </p>

          <p class="font-body text-base text-muted leading-relaxed mb-10 max-w-2xl mx-auto animate-on-scroll" style="animation-delay:0.2s">
            The work starts with Stewarding the Shift, readiness training for your board, leaders, staff, and volunteers, delivered as a keynote, a team training, or a board briefing.
          </p>

          <div class="flex flex-wrap justify-center gap-4 mb-3 animate-on-scroll" style="animation-delay:0.25s">
            <a href={WEBINAR_URL} target="_blank" rel="noopener noreferrer" class="btn-teal text-base !py-3.5 !px-7">
              Register for Stewarding the Shift, Nov 21
              <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </a>
            <a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer" class="btn-outline-teal text-base !py-3.5">
              Book a Call
            </a>
          </div>
          <p class="booking-note mb-12">{BOOKING_NOTE}</p>

          <!-- Social proof bar -->
          <div class="flex flex-wrap justify-center gap-6 animate-on-scroll" style="animation-delay:0.3s">
            {[
              { num: '15+', label: 'Yrs Organizational Practice' },
              { num: '3', label: 'Diagnostic Volumes Published' },
              { num: '6', label: 'UNMASK Pillars' },
              { num: 'AI', label: 'Human Readiness Focus' },
            ].map((s) => (
              <div class="border-l-2 border-teal-DEFAULT/40 pl-3">
                <p class="font-heading text-xl text-teal-DEFAULT font-bold leading-none">{s.num}</p>
                <p class="text-muted text-xs mt-1">{s.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Photo + credential -->
        <div class="lg:col-span-5 flex flex-col gap-4 animate-on-scroll" style="animation-delay:0.35s">

          <!-- Photo -->
          <div class="relative rounded-lg overflow-hidden border border-teal-DEFAULT/25"
               style="background: linear-gradient(135deg, #0a2540 0%, #0f172a 100%);">
            <img
              src="/images/nc-recalibrate.webp"
              alt="Nikki Cates - CEO &amp; Founder, Strategic Transformations Readiness Group"
              class="w-full h-auto object-cover object-top"
              style="max-height: 420px; object-position: center top;"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <!-- Photo overlay tag -->
            <div class="absolute bottom-0 left-0 right-0 p-4"
                 style="background: linear-gradient(to top, rgba(15,23,42,0.92) 60%, transparent);">
              <p class="font-heading text-light text-sm font-semibold">Nikki Cates</p>
              <p class="text-teal-DEFAULT text-xs font-body font-bold uppercase tracking-widest">
                CEO &amp; Founder, Strategic Transformations Readiness Group
              </p>
            </div>
          </div>

          <!-- Credential pills -->
          <div class="grid grid-cols-2 gap-3">
            {[
              { icon: '🎖️', label: 'Army Veteran' },
              { icon: '✍🏾', label: 'Womanist Scholar' },
              { icon: '📖', label: 'Published Author' },
              { icon: '🌍', label: 'Keynote Speaker' },
            ].map((item) => (
              <div class="card teal-hover flex items-center gap-3 py-3 px-4">
                <span class="text-xl shrink-0">{item.icon}</span>
                <p class="font-heading text-light font-semibold text-xs">{item.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-28" style="background: linear-gradient(to bottom, transparent, #0f172a);"></div>
  </section>


  <!-- ─── STATISTICS BAND ──────────────────────────────
       Approved statistics only. Do not add, round, or change a number without a named, linked source. -->
  <section class="py-16 bg-[#0c1525]" aria-labelledby="gap-heading">
    <div class="container-wide">
      <h2 id="gap-heading" class="font-heading text-3xl md:text-4xl text-light text-center mb-10 animate-on-scroll">
        The gap is already here
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {[
          {
            num: '58%',
            text: 'of mission organizations have no AI roadmap.',
            source: 'The State of Nonprofit AI',
            detail: 'NTEN and The Bridgespan Group, 2026, 917 nonprofit staff and executives worldwide',
            href: 'https://nonprofitquarterly.org/how-nonprofits-adopt-and-govern-ai-insights-from-a-new-report/',
          },
          {
            num: '92%',
            text: 'of nonprofits use AI tools, and <strong class="text-teal-DEFAULT">47%</strong> have no AI governance policy.',
            source: 'The 2026 Nonprofit AI Adoption Report',
            detail: 'Virtuous and Fundraising.AI, 346 nonprofits',
            href: 'https://www.nonprofitpro.com/article/nonprofit-ai-adoption-hits-92-but-only-7-see-major-impact/',
          },
          {
            num: '94%',
            text: 'of pastors believe a church should have responsible AI guidelines. <strong class="text-teal-DEFAULT">21%</strong> say their church has them.',
            source: 'Barna',
            detail: '',
            href: 'https://www.crosswalk.com/headlines/contributors/michael-foust/seminary-professor-warns-pastors-against-ai-written-sermons-ai-has-no-soul.html',
          },
        ].map((stat, i) => (
          <div class="card teal-hover flex flex-col gap-3 text-center animate-on-scroll" style={`animation-delay:${i * 0.05}s`}>
            <p class="text-light text-base leading-relaxed flex-1">
              <span class="block font-heading text-5xl text-teal-DEFAULT font-bold leading-none mb-3">{stat.num}</span>
              <Fragment set:html={stat.text} />
            </p>
            <p class="text-muted text-xs leading-relaxed">
              Source: <a href={stat.href} target="_blank" rel="noopener noreferrer" class="underline hover:text-teal-DEFAULT transition-colors">{stat.source}<span class="sr-only"> (opens in a new tab)</span></a>{stat.detail && ` (${stat.detail})`}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center animate-on-scroll">
        <p class="font-heading text-2xl text-light mb-6 mx-auto">Hold the people who hold your mission.</p>
        <a href={WEBINAR_URL} target="_blank" rel="noopener noreferrer" class="btn-teal text-base !py-3.5 !px-7">
          Register for Stewarding the Shift, Nov&nbsp;21<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>


  <!-- ─── FREE WEBINAR ─────────────────────────────────
       Time-bound: after November 21, 2026, remove this section or replace it with the
       webinar recording (and remove the "Free Webinar" nav links in Nav.astro). -->
  <section id="webinar" class="py-16 scroll-mt-28" style="background: radial-gradient(ellipse at 20% 20%, #0d2a45 0%, #06111f 60%);">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div class="text-center animate-on-scroll">
          <span class="st-tag mb-4 inline-flex">Free Webinar</span>
          <h2 class="font-heading text-3xl md:text-4xl text-light mb-4 leading-snug">
            Stewarding the Shift: What Readiness Looks Like for Your Mission
          </h2>
          <p class="text-teal-DEFAULT font-semibold mb-2 mx-auto">Free 45-minute webinar</p>
          <p class="text-muted text-base mb-8 mx-auto">Saturday, November 21, 2026, 11 a.m. Eastern, on Zoom.</p>
          <a href={WEBINAR_URL} target="_blank" rel="noopener noreferrer" class="btn-teal text-base !py-3.5 !px-8">
            Register for Stewarding the Shift, Nov 21
          </a>
        </div>

        <div class="animate-on-scroll" style="animation-delay:0.1s">
          <p class="font-body text-xs font-bold uppercase tracking-widest text-teal-DEFAULT mb-4 mx-auto text-center">What you will learn</p>
          <div class="space-y-3 mb-5">
            {[
              'Why mission organizations need human readiness for AI now.',
              'Who absorbs the cost when AI arrives without a plan.',
              'What bringing Nikki in looks like as a keynote, team training, or board briefing.',
            ].map((item) => (
              <div class="card teal-hover flex items-start gap-3 py-4 px-5">
                <span class="text-teal-DEFAULT shrink-0 mt-0.5 text-sm">→</span>
                <p class="text-light text-sm leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
          <p class="text-muted text-sm italic mx-auto text-center">Everyone who attends receives the First AI Policy starter sheet.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PAIN POINT RECOGNITION ───────────────────── -->
  <section class="py-20 bg-[#0c1525]">
    <div class="container-wide">
      <div class="max-w-2xl mx-auto text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">What It Feels Like Inside</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">
          Mission organizations are adopting AI faster than their structures can hold it.
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          'Your best people are tired, talented, and quietly calculating their exit.',
          'AI adoption is moving faster than your decision rights, workflows, and leadership capacity.',
          'Staff and volunteer leaders are absorbing pressure from every direction without the authority to redesign the load.',
          'Change fatigue has made every new initiative feel like another demand instead of a path forward.',
          'Institutional knowledge is sitting with the same over-relied-upon people you cannot afford to lose.',
          'Teams are using AI tools unevenly, anxiously, or in ways that expose deeper role confusion.',
        ].map((pain, i) => (
          <div class="card teal-hover flex items-start gap-3 animate-on-scroll" style={`animation-delay:${i * 0.05}s`}>
            <span class="text-teal-DEFAULT shrink-0 mt-1 text-sm">→</span>
            <p class="text-muted text-sm leading-relaxed">{pain}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center animate-on-scroll">
        <p class="font-heading text-xl text-light mb-2 mx-auto">If any of that landed, your structure is carrying more than it was built for.</p>
        <p class="text-muted text-sm mb-6 max-w-lg mx-auto">
          Before you add more technology, find out whether your people, decision rights, and policies can carry it.
        </p>
        <a href="#how-we-work" class="btn-teal">See How the Work Works →</a>
      </div>
    </div>
  </section>


  <!-- ─── PHOTO BREAK ───────────────────────────────── -->
  <div class="w-full h-56 md:h-72 overflow-hidden">
    <img
      src="/images/home/inclusive-workspace.jpg"
      alt="Diverse inclusive team working together in a modern open office environment"
      class="w-full h-full object-cover opacity-75"
      style="object-position: center 30%;"
      loading="lazy"
    />
  </div>

  <!-- ─── TRANSFORMATION OUTCOMES ──────────────────── -->
  <section class="section-pad relative overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(13,158,138,0.05) 0%, transparent 65%);"></div>
    <div class="container-wide relative z-10">
      <div class="text-center mb-14 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">The Shift</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">What changes when you fix the design.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border max-w-4xl mx-auto rounded-lg overflow-hidden">
        {[
          { before: 'AI adoption treated as a tool rollout', after: 'AI adoption guided by structural readiness and human capacity' },
          { before: 'Best people carrying invisible overload', after: 'Load paths mapped before attrition becomes the signal' },
          { before: 'Leaders reacting to burnout after damage is done', after: 'Leaders diagnosing the conditions producing burnout' },
          { before: 'Staff and volunteers absorbing change without a voice', after: 'Decision rights, responsibilities, and escalation paths clarified' },
          { before: 'AI use happening with no written policy', after: 'A written AI policy with a human in the loop at every level' },
          { before: 'Initiatives competing for the same exhausted people', after: 'Transformation paced around the structure that must carry it' },
        ].map((item) => (
          <div class="bg-surface p-6 flex gap-6 items-start">
            <div class="flex-1">
              <p class="text-xs font-body font-bold uppercase tracking-widest text-red-400/70 mb-2">Before</p>
              <p class="text-muted text-sm">{item.before}</p>
            </div>
            <div class="text-teal-DEFAULT/40 text-xl shrink-0 mt-3">→</div>
            <div class="flex-1">
              <p class="text-xs font-body font-bold uppercase tracking-widest text-teal-DEFAULT mb-2">After</p>
              <p class="text-light text-sm font-medium">{item.after}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


   <!-- ─── PHOTO BREAK 2 ─────────────────────────────── -->
  <div class="w-full h-56 md:h-72 overflow-hidden">
    <img
      src="/images/bootcamp/modern-inclusive-office.jpg"
      alt="Diverse professionals working in a modern inclusive open-plan office"
      class="w-full h-full object-cover opacity-75"
      style="object-position: center 25%;"
      loading="lazy"
    />
  </div>

  <!-- ─── WHO WE SERVE / HOW WE WORK ──────────── -->
  <section id="how-we-work" class="section-pad bg-[#0c1525] scroll-mt-28">
    <div class="container-wide">
      <div class="text-center mb-12 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">Who We Serve</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">Built for organizations that carry a mission and a team.</h2>
        <p class="text-muted text-sm mt-3 max-w-md mx-auto">
          Strategic Transformations Readiness Group partners with mission-driven and faith-based organizations preparing their people for AI.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
        {[
          {
            label: 'Nonprofits and 501(c)(3)s',
            badge: 'Mission-Driven',
            desc: 'Organizations preparing staff, volunteers, and boards for AI while protecting the trust of the people they serve.',
          },
          {
            label: 'Faith-Based Businesses and Institutions',
            badge: 'Values-Led',
            desc: 'Organizations whose values shape how they work and who want AI decisions to reflect those values.',
          },
          {
            label: 'Churches and Church Bodies',
            badge: 'Faith Communities',
            desc: 'Congregations, ministries, and church bodies that want clear guidelines for responsible AI use.',
          },
        ].map((item) => (
          <div class="card teal-hover flex flex-col gap-3 animate-on-scroll">
            <div class="flex items-center justify-between mb-1">
              <span class="st-tag">{item.badge}</span>
            </div>
            <h3 class="font-heading text-xl font-bold text-teal-DEFAULT">{item.label}</h3>
            <p class="text-muted text-sm leading-relaxed flex-1">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center animate-on-scroll">
        <p class="font-body text-xs font-bold uppercase tracking-widest text-muted mb-4 mx-auto">Who we work with</p>
        <div class="flex flex-wrap justify-center gap-3">
          {['Boards', 'Executive Directors and Pastors', 'Executive Teams', 'Staff', 'Contractors', 'Volunteers'].map((who) => (
            <span class="st-tag">{who}</span>
          ))}
        </div>
      </div>

      <div class="text-center mt-16 mb-10 animate-on-scroll">
        <span class="st-tag mb-4 inline-flex">How We Work</span>
        <h2 class="font-heading text-3xl md:text-4xl text-light">One path, four steps.</h2>
        <p class="text-muted text-sm mt-3 max-w-md mx-auto">Every engagement begins with a discovery call.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          {
            num: '01',
            label: 'Stewarding the Shift',
            desc: 'Readiness training for your people, delivered as a keynote, a team training, or a board briefing.',
          },
          {
            num: '02',
            label: 'Structural Review',
            desc: 'We look at where strain sits, who carries it, and where AI is about to land on it.',
          },
          {
            num: '03',
            label: 'Governance and Policy',
            desc: 'Clear decision rights, a written AI policy built on the principles of responsible AI, and a human in the loop at every level.',
          },
          {
            num: '04',
            label: 'Fractional Support',
            desc: 'Ongoing support so your team acts on the roadmap and the structure holds.',
          },
        ].map((item) => (
          <div class="card teal-hover flex flex-col gap-3 animate-on-scroll">
            <span class="font-heading text-3xl text-teal-DEFAULT/30 font-bold leading-none">{item.num}</span>
            <p class="font-heading text-teal-DEFAULT text-xl font-bold">{item.label}</p>
            <p class="text-muted text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10 animate-on-scroll">
        <a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer" class="btn-teal">Book a Call →</a>
        <p class="booking-note">{BOOKING_NOTE}</p>
      </div>
    </div>
  </section>


  <!-- ─── STEWARDING THE SHIFT (ORGANIZATIONAL TRAINING) ─── -->
  <section class="section-pad">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div class="text-center animate-on-scroll">
          <span class="st-tag mb-5 inline-flex">Readiness Training for Organizations</span>
          <h2 class="font-heading text-3xl md:text-5xl text-light mb-5">
            Stewarding<br/><span class="text-teal-DEFAULT">the Shift.</span>
          </h2>
          <p class="text-muted leading-relaxed mb-4 mx-auto">
            Bring Nikki in to prepare your board, leaders, staff, and volunteers for AI.
            Available as a keynote, team training, or board briefing.
          </p>
          <p class="text-light leading-relaxed mb-1 mx-auto">
            Nonprofit staff are nearly twice as likely as executives to feel very uncomfortable with AI (19% vs. 10%).
          </p>
          <p class="text-muted text-xs mb-4 mx-auto">
            Source: <a href="https://nonprofitquarterly.org/how-nonprofits-adopt-and-govern-ai-insights-from-a-new-report/" target="_blank" rel="noopener noreferrer" class="underline hover:text-teal-DEFAULT transition-colors">The State of Nonprofit AI<span class="sr-only"> (opens in a new tab)</span></a>, 2026
          </p>
          <p class="text-muted leading-relaxed mb-8 mx-auto">
            The training is built on the UNMASK Leadership Architecture: six pillars that move your
            organization from readiness, to governance, to sustainability.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer" class="btn-teal">Book a Call →</a>
            <a href="/speaking-training/" class="btn-outline-teal">Speaking &amp; Training</a>
          </div>
          <p class="booking-note">{BOOKING_NOTE}</p>
        </div>

        <div class="space-y-3 animate-on-scroll" style="animation-delay:0.2s">
          {[
            {
              group: 'Readiness',
              pillars: [
                { name: 'Uncover', desc: 'The team names where strain sits and who carries it.' },
                { name: 'Navigate', desc: 'Communication styles across generations.' },
                { name: 'Manage', desc: 'Myth versus truth, hands-on time with the tools, ready in mind and heart for technical training ahead.' },
              ],
            },
            {
              group: 'Governance',
              pillars: [
                { name: 'Advocate', desc: 'Clear decision rights, a written AI policy built on the principles of responsible AI, a human in the loop at every level.' },
              ],
            },
            {
              group: 'Sustainability',
              pillars: [
                { name: 'Sustain', desc: 'A roadmap the team acts on.' },
                { name: 'Kindle', desc: 'Emotional and spiritual intelligence: is this the right thing to do?' },
              ],
            },
          ].map((g) => (
            <div class="p-4 rounded-md border border-border hover:border-teal-DEFAULT/30 transition-colors bg-surface/50">
              <p class="font-body text-xs font-bold uppercase tracking-widest text-teal-DEFAULT mb-3">{g.group}</p>
              <div class="space-y-3">
                {g.pillars.map((p) => (
                  <div class="flex items-start gap-4">
                    <span class="font-heading text-teal-DEFAULT text-2xl font-bold w-7 shrink-0">{p.name[0]}</span>
                    <div>
                      <p class="font-heading text-light font-semibold text-sm mb-1">{p.name}</p>
                      <p class="text-muted text-xs leading-relaxed">{p.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
          <!-- Entry offer -->
          <div class="p-4 rounded-md border border-teal-DEFAULT/30 bg-teal-DEFAULT/5">
            <p class="font-body text-xs font-bold uppercase tracking-widest text-teal-DEFAULT mb-1">Stewarding the Shift</p>
            <p class="text-light text-sm font-semibold">Holding the People Who Hold Your Mission</p>
            <p class="text-muted text-xs mt-1">Available as a keynote, team training, or board briefing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── MEET NIKKI ────────────────────────────────── -->
  <section class="section-pad relative overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 60% at 20% 50%, rgba(13,158,138,0.05) 0%, transparent 65%);"></div>
    <div class="container-wide relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 animate-on-scroll">
          <img
